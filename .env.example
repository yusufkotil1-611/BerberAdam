# --- BERBERADAM ortam değişkenleri ---
# Geliştirmede (npm run dev) hiçbirini doldurmanız gerekmez: yerel SQLite dosyası (data/) kullanılır.
# Canlıda (Netlify) bunları site ayarlarına girin (bkz. DEPLOY.md).

# ===== Veri tabanı (Turso) — Netlify için ZORUNLU =====
# Turso panelinden alın: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== Ayrı alan adları =====
# Yönetim paneli için ayrı alan adı (https:// olmadan). Doluysa:
#   - bu alan adında yalnızca /admin ve /api/admin çalışır ("/" → /admin),
#   - diğer tüm alan adlarında (müşteri sitesi) /admin ve /api/admin tamamen kapalıdır (404).
# Boşsa her şey tek adreste çalışır (geliştirme). Birden fazla için virgülle ayırın.
ADMIN_HOST=

# Müşteri sitesinin tam adresi (https ile, sonunda / olmadan). Yönetim panelindeki "Siteye dön"
# bağlantısı, robots.txt ve sitemap.xml bunu kullanır.
PUBLIC_URL=

# ===== Güvenlik =====
# İlk kurulumda admin şifresi olarak 000000 yerine bunu kullanır (en az 6 karakter).
# Yalnızca veri tabanı İLK oluşturulurken okunur; sonrasında panelden değiştirin.
ADMIN_INITIAL_PASSWORD=

# Oturum (JWT) imzalama anahtarı. Boşsa otomatik üretilip veri tabanında saklanır (ek ayar gerekmez).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== Yalnızca kendi sunucunuzda (VPS) =====
# Turso yerine yerel SQLite dosyası kullanılacaksa dosya yolu (varsayılan: ./data/berberadam.db)
DATABASE_PATH=
